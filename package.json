{
  "name": "git-judge-jev",
  "version": "0.0.0",
  "description": "GitHub Action that posts one PR comment: what the PR really does, which hunks need a human, why, and what to verify. Runs on TypeSafe Jev.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-judge-jev": "dist/index.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "esbuild src/entry.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --legal-comments=none --banner:js=\"#!/usr/bin/env node\"",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/git-judge-jev-eval.mjs && node --env-file=.env node_modules/.cache/git-judge-jev-eval.mjs",
    "corpus": "esbuild scripts/corpus.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/git-judge-jev-corpus.mjs && node node_modules/.cache/git-judge-jev-corpus.mjs",
    "try": "esbuild scripts/try.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/git-judge-jev-try.mjs && node --env-file=.env node_modules/.cache/git-judge-jev-try.mjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.126.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "openai": "^7.18.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
